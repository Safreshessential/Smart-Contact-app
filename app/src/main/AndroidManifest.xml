<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Smart Contact"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

<activity
    android:name=".ContactBackupActivity"
    android:exported="false" />

<activity
    android:name=".SmartCallActivity"
    android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

<service
    android:name=".SmartInCallService"
    android:permission="android.permission.BIND_INCALL_SERVICE"
    android:exported="true">

    <meta-data
        android:name="android.telecom.IN_CALL_SERVICE_UI"
        android:value="true" />

    <intent-filter>
        <action android:name="android.telecom.InCallService" />
    </intent-filter>

</service>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".HiddenContactsActivity"
            android:exported="false" />

        <activity
            android:name=".EmailRecoveryActivity"
            android:exported="false" />

        <activity
            android:name=".SpamProtectionActivity"
            android:exported="false" />

        <service
            android:name=".KnownSpamCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>

        </service>

    </application>

</manifest>